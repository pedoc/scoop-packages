                "url": ["https://example.com/multi/$version/x64.zip", "https://example.com/multi/$version/help.zip"],
                "extract_dir": ["multi-$version", "help-$version"]
            },
            "arm64": {"url": ["https://example.com/multi/$version/arm64.zip", "https://example.com/multi/$version/help.zip"]}
        }
    }
