    "url": ["https://example.com/multi/2.4.0/data.zip", "https://example.com/multi/2.4.0/help.zip"],
    "hash": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
    "architecture": {
        "32bit": {},
        "64bit": {
            "url": ["https://example.com/multi/2.4.0/x64.zip", "https://example.com/multi/2.4.0/help.zip"],
            "hash": ["cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"],
            "extract_dir": ["multi-2.4.0", "help-2.4.0"]
