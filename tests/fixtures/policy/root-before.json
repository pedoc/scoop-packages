{
    "version": "1.2.3",
    "description": "Offline policy fixture — not executable",
    "homepage": "https://example.com/tool",
    "license": "MIT",
    "url": "https://example.com/tool/v1.2.3/tool.zip#/tool.zip",
    "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "extract_dir": "tool-1.2.3",
    "bin": [
        ["tool-1.2.3/tool.exe", "tool"]
    ],
    "shortcuts": [
        ["tool-1.2.3/tool.exe", "Tool 1.2.3"]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://example.com/tool/v$version/tool.zip#/tool.zip",
        "extract_dir": "tool-$version",
        "bin": [
            ["tool-$version/tool.exe", "tool"]
        ],
        "shortcuts": [
            ["tool-$version/tool.exe", "Tool $version"]
        ],
        "hash": {
            "url": "https://example.com/tool/v$version/checksums.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
